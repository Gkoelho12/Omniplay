{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/mexicana", "destination": "/mexicana.html" },
    { "source": "/amigos", "destination": "/amigos.html" },
    { "source": "/friends", "destination": "/amigos.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
